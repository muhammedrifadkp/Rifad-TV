# Copy to .env.local for local overrides, and set the same variable in Vercel
# (Project → Settings → Environment Variables) before going live.

# Public production URL, without a trailing slash. Used for canonical links,
# hreflang alternates, Open Graph URLs, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional, for `npm run media` only: folder holding the original photos, films,
# profil-*.jpeg and logo.PNG. Defaults to the folder above website/.
# MEDIA_SOURCE_DIR=..
